{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "download-image-model"
  },
  "spec": {
    "backoffLimit": 1,
    "activeDeadlineSeconds": 1800,
    "template": {
      "spec": {
        "serviceAccountName": "image-generator",
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "securityContext": {
          "runAsNonRoot": true,
          "fsGroup": 1000000000
        },
        "containers": [
          {
            "name": "download",
            "image": "registry.redhat.io/rhaii/vllm-cuda-rhel9@sha256:c056e61672b6aea489ad5dde0bd2f8497230f5333e87f7cf6c494eba3bfdc808",
            "command": [
              "python",
              "-u",
              "-c",
              "from huggingface_hub import snapshot_download\nfrom pathlib import Path\nimport json\np=snapshot_download(repo_id='stable-diffusion-v1-5/stable-diffusion-v1-5', revision='451f4fe16113bff5a5d2269ed5ad43b0592e9a14', local_dir='/models/sd15', allow_patterns=['*.json','tokenizer/*','*.fp16.safetensors','README.md','LICENSE*'], max_workers=4)\nfiles=list(Path(p).rglob('*.safetensors'))\nassert len(files)==4, f'Expected 4 weight components, got {len(files)}'\nprint('DOWNLOAD-VERIFIED',sum(f.stat().st_size for f in files),flush=True)\n"
            ],
            "env": [
              {
                "name": "HF_HOME",
                "value": "/tmp/hf"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "0"
              },
              {
                "name": "TRANSFORMERS_OFFLINE",
                "value": "0"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "1",
                "memory": "2Gi"
              },
              "limits": {
                "cpu": "2",
                "memory": "4Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumeMounts": [
              {
                "name": "models",
                "mountPath": "/models"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "models",
            "persistentVolumeClaim": {
              "claimName": "image-model-cache"
            }
          }
        ],
        "nodeSelector": {
          "kubernetes.io/hostname": "gpu-worker-02"
        }
      }
    }
  }
}
