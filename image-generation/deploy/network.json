{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "image-generator-ingress"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "serving.kserve.io/inferenceservice": "image-generator"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "policy-group.network.openshift.io/ingress": ""
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8443
          }
        ]
      }
    ]
  }
}
