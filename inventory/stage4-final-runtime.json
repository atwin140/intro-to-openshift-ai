    "spec": {
        "annotations": {
            "opendatahub.io/kserve-runtime": "vllm",
            "prometheus.io/path": "/metrics",
            "prometheus.io/port": "8080"
        },
        "containers": [
            {
                "args": [
                    "--port=8080",
                    "--model=/mnt/models",
                    "--served-model-name={{.Name}}",
                    "--dtype=float16",
                    "--max-model-len=4096",
                    "--max-num-seqs=2",
                    "--max-num-batched-tokens=4096",
                    "--gpu-memory-utilization=0.90",
                    "--enforce-eager",
                    "--generation-config=vllm",
                    "--override-generation-config={\"max_new_tokens\":768}",
                    "--quantization=awq"
                ],
                "command": [
                    "python",
                    "-m",
                    "vllm.entrypoints.openai.api_server"
                ],
                "env": [
                    {
                        "name": "HF_HOME",
                        "value": "/tmp/hf_home"
                    },
                    {
                        "name": "HF_HUB_OFFLINE",
                        "value": "1"
                    },
                    {
                        "name": "VLLM_NO_USAGE_STATS",
                        "value": "1"
                    },
                    {
                        "name": "DO_NOT_TRACK",
                        "value": "1"
                    }
                ],
                "image": "registry.redhat.io/rhaii/vllm-cuda-rhel9@sha256:c056e61672b6aea489ad5dde0bd2f8497230f5333e87f7cf6c494eba3bfdc808",
                "name": "kserve-container",
                "ports": [
                    {
                        "containerPort": 8080,
                        "protocol": "TCP"
                    }
                ],
                "readinessProbe": {
                    "failureThreshold": 3,
                    "httpGet": {
                        "path": "/health",
                        "port": 8080
                    },
                    "periodSeconds": 10
                },
                "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                        "drop": [
                            "ALL"
                        ]
                    },
                    "runAsNonRoot": true,
                    "seccompProfile": {
                        "type": "RuntimeDefault"
                    }
                },
                "startupProbe": {
                    "failureThreshold": 90,
                    "httpGet": {
                        "path": "/health",
                        "port": 8080
                    },
                    "periodSeconds": 10
                },
                "volumeMounts": [
                    {
                        "mountPath": "/dev/shm",
                        "name": "shm"
                    },
                    {
                        "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
                        "name": "no-api-credentials",
                        "readOnly": true
                    }
                ]
            }
        ],
        "multiModel": false,
        "supportedModelFormats": [
            {
                "autoSelect": true,
                "name": "vLLM"
            }
        ]
    }
